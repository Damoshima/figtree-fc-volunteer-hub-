# Supabase Configuration (Free Tier PostgreSQL)
# Leave blank during initial local testing to run in built-in Seed Mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Swappable Notification Adapter Configuration
# Options: "in_app_log" (default, $0 cost) | "webhook_smtp" (connects to club email relay/Resend/SMTP)
NOTIFICATION_PROVIDER=in_app_log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_FROM_EMAIL=volunteers@figtreefc.example.org.au